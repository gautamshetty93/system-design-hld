      "link": null,
      "locked": false,
      "text": "Eureka Server\n- Acts like a phonebook\n- Has all the instance info of registered client like:\n * Service name\n * Instance id\n * IP\n * Port number\n * Health status etc",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 193,
      "containerId": null,
      "originalText": "Eureka Server\n- Acts like a phonebook\n- Has all the instance info of registered client like:\n * Service name\n * Instance id\n * IP\n * Port number\n * Health status etc",
      "lineHeight": 1.25
    },
